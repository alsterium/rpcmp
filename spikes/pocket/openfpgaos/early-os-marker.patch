+#ifdef RPCMP_EARLY_MARKER
+#include "../hal/regs.h"
+
+static void rpcmp_early_marker(void) {
+    volatile uint8_t *fb = (volatile uint8_t *)TERM_FB_BASE;
+    for (uint32_t y = 0; y < 16; y++) {
+        for (uint32_t x = 0; x < 320; x++)
+            fb[y * 320u + x] = 15u;
+    }
+    __asm__ volatile("fence" ::: "memory");
+    for (;;) {}
+}
+#endif
