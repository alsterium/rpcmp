diff --git a/src/firmware/os/kernel/main.c b/src/firmware/os/kernel/main.c
--- a/src/firmware/os/kernel/main.c
+++ b/src/firmware/os/kernel/main.c
@@ -41,1 +41,2 @@
-    RPCMP_EARLY_MARKER == 11 || RPCMP_EARLY_MARKER == 12
+    RPCMP_EARLY_MARKER == 11 || RPCMP_EARLY_MARKER == 12 || \
+    RPCMP_EARLY_MARKER == 13
@@ -61,1 +62,1 @@
-    RPCMP_EARLY_MARKER == 12
+    RPCMP_EARLY_MARKER == 12 || RPCMP_EARLY_MARKER == 13
@@ -103,1 +104,1 @@
-    RPCMP_EARLY_MARKER == 12
+    RPCMP_EARLY_MARKER == 12 || RPCMP_EARLY_MARKER == 13
@@ -496,1 +497,1 @@ void os_main(void) {
-     RPCMP_EARLY_MARKER == 12)
+     RPCMP_EARLY_MARKER == 12 || RPCMP_EARLY_MARKER == 13)
@@ -503,1 +504,11 @@ void os_main(void) {
-#if RPCMP_EARLY_MARKER == 12
+#if RPCMP_EARLY_MARKER == 13
+    extern void rpcmp_term_reset_state_only(void);
+    of_video_init();
+    rpcmp_init_terminal_palette();
+    while (PAL_INDEX & PAL_INDEX_BUSY) {}
+    of_video_set_palette(15, 0xFF, 0xFF, 0xFF);
+    while (PAL_INDEX & PAL_INDEX_BUSY) {}
+    of_video_set_display_mode(0);
+    rpcmp_term_reset_state_only();
+    rpcmp_terminal_framebuffer_marker();
+#elif RPCMP_EARLY_MARKER == 12
diff --git a/src/firmware/os/targets/pocket/terminal.c b/src/firmware/os/targets/pocket/terminal.c
--- a/src/firmware/os/targets/pocket/terminal.c
+++ b/src/firmware/os/targets/pocket/terminal.c
@@ -334,0 +335,10 @@
+
+#if defined(RPCMP_EARLY_MARKER) && RPCMP_EARLY_MARKER == 13
+void rpcmp_term_reset_state_only(void) {
+    term_fg = OF_COLOR_WHITE;
+    term_bg = OF_COLOR_BLACK;
+    esc_state = ESC_NONE;
+    term_col = 0;
+    term_row = 0;
+}
+#endif
