-    sw      a1, 16(a0)
-    sw      a1, 20(a0)
-    sw      a1, 24(a0)
-    sw      a1, 28(a0)
-    sw      a1, 32(a0)
-    sw      a1, 36(a0)
-    sw      a1, 40(a0)
-    sw      a1, 44(a0)
-    sw      a1, 48(a0)
-    sw      a1, 52(a0)
-    sw      a1, 56(a0)
-    sw      a1, 60(a0)
-    addi    a0, a0, 64
-    addi    a2, a2, -64
-    bgeu    a2, t1, .Lset_64
-
-.Lset_32:
