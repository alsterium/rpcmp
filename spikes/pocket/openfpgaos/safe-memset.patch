diff --git a/src/firmware/os/hal/fast_mem.S b/src/firmware/os/hal/fast_mem.S
--- a/src/firmware/os/hal/fast_mem.S
+++ b/src/firmware/os/hal/fast_mem.S
@@ -14,2 +14,3 @@
- *   memset:          plain 16-word unrolled stores (store buffer
- *                    handles write-allocate pipelining)
+ *   memset:          one word store per loop iteration. Pocket hardware
+ *                    testing showed that long back-to-back store runs can
+ *                    stop forward progress in the cached SDRAM path.
@@ -188,2 +189,3 @@ memcpy:
- * Plain 16-word unrolled stores. The store buffer handles
- * write-allocate pipelining, so this is the fastest approach we have.
+ * Keep integer work and a branch between word stores. A 16-word unrolled
+ * store sequence reproducibly stopped Pocket hardware while the equivalent
+ * single-store loop completed against the same aligned SDRAM destination.
@@ -208,38 +210,0 @@ memset:
-    li      t1, 64
