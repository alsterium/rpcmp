diff --git a/src/firmware/os/hal/memtest.c b/src/firmware/os/hal/memtest.c
--- a/src/firmware/os/hal/memtest.c
+++ b/src/firmware/os/hal/memtest.c
@@ -48,0 +49,4 @@
+#ifdef RPCMP_MEMOPS_SELFTEST
+#include <string.h>
+#endif
+
@@ -174,0 +179,154 @@ int of_memtest_boot(void) {
+
+#ifdef RPCMP_MEMOPS_SELFTEST
+
+#define MEMOPS_CAPACITY 4224u
+
+static uint8_t memops_src[MEMOPS_CAPACITY] __attribute__((aligned(64)));
+static uint8_t memops_dst[MEMOPS_CAPACITY] __attribute__((aligned(64)));
+static uint8_t memops_ref[MEMOPS_CAPACITY] __attribute__((aligned(64)));
+
+static const char *memops_fail_kind;
+static uint32_t memops_fail_case;
+static uint32_t memops_fail_offset;
+static uint32_t memops_fail_want;
+static uint32_t memops_fail_got;
+
+static uint8_t memops_pattern(uint32_t index, uint32_t salt) {
+    return (uint8_t)((index * 37u + (index >> 3) * 11u + salt) & 0xFFu);
+}
+
+static void memops_fill(volatile uint8_t *buffer, uint32_t salt) {
+    for (uint32_t i = 0; i < MEMOPS_CAPACITY; i++)
+        buffer[i] = memops_pattern(i, salt);
+}
+
+static void memops_copy_reference(volatile uint8_t *dest,
+                                  const volatile uint8_t *src) {
+    for (uint32_t i = 0; i < MEMOPS_CAPACITY; i++)
+        dest[i] = src[i];
+}
+
+static int memops_compare(const char *kind, uint32_t case_index,
+                          const volatile uint8_t *actual,
+                          const volatile uint8_t *expected) {
+    for (uint32_t i = 0; i < MEMOPS_CAPACITY; i++) {
+        if (actual[i] != expected[i]) {
+            memops_fail_kind = kind;
+            memops_fail_case = case_index;
+            memops_fail_offset = i;
+            memops_fail_want = expected[i];
+            memops_fail_got = actual[i];
+            return -1;
+        }
+    }
+    return 0;
+}
+
+static int memops_test_memcpy(void) {
+    static const uint16_t sizes[] = {
+        0, 1, 2, 3, 4, 7, 15, 16, 31, 32, 33,
+        63, 64, 65, 127, 128, 255, 256, 1023, 2048, 4096,
+    };
+    static const uint8_t offsets[][2] = {
+        {0, 0}, {1, 0}, {0, 1}, {3, 2}, {4, 4}, {60, 60},
+    };
+    uint32_t case_index = 0;
+
+    for (uint32_t s = 0; s < sizeof(sizes) / sizeof(sizes[0]); s++) {
+        for (uint32_t o = 0; o < sizeof(offsets) / sizeof(offsets[0]); o++) {
+            const uint32_t dest_offset = offsets[o][0];
+            const uint32_t src_offset = offsets[o][1];
+            const uint32_t count = sizes[s];
+
+            memops_fill(memops_src, 0x31u + case_index);
+            memops_fill(memops_dst, 0xA7u + case_index);
+            memops_copy_reference(memops_ref, memops_dst);
+            for (uint32_t i = 0; i < count; i++)
+                ((volatile uint8_t *)memops_ref)[dest_offset + i] =
+                    ((volatile uint8_t *)memops_src)[src_offset + i];
+
+            void *result = memcpy(memops_dst + dest_offset,
+                                  memops_src + src_offset, count);
+            if (result != memops_dst + dest_offset) {
+                memops_fail_kind = "memcpy-ret";
+                memops_fail_case = case_index;
+                memops_fail_offset = 0;
+                memops_fail_want = (uintptr_t)(memops_dst + dest_offset);
+                memops_fail_got = (uintptr_t)result;
+                return -1;
+            }
+            if (memops_compare("memcpy", case_index,
+                               memops_dst, memops_ref))
+                return -1;
+            case_index++;
+        }
+    }
+    return 0;
+}
+
+static void memops_move_reference(volatile uint8_t *buffer,
+                                  uint32_t dest_offset,
+                                  uint32_t src_offset,
+                                  uint32_t count) {
+    if (dest_offset <= src_offset) {
+        for (uint32_t i = 0; i < count; i++)
+            buffer[dest_offset + i] = buffer[src_offset + i];
+    } else {
+        for (uint32_t i = count; i > 0; i--)
+            buffer[dest_offset + i - 1u] = buffer[src_offset + i - 1u];
+    }
+}
+
+static int memops_test_memmove(void) {
+    static const uint16_t sizes[] = {
+        0, 1, 3, 4, 15, 16, 31, 32, 63, 64, 65,
+        127, 128, 255, 256, 1023, 2048, 4096,
+    };
+    static const uint8_t offsets[][2] = {
+        {0, 64}, {64, 0}, {1, 65}, {65, 1}, {2, 3}, {3, 2},
+    };
+    uint32_t case_index = 0;
+
+    for (uint32_t s = 0; s < sizeof(sizes) / sizeof(sizes[0]); s++) {
+        for (uint32_t o = 0; o < sizeof(offsets) / sizeof(offsets[0]); o++) {
+            const uint32_t dest_offset = offsets[o][0];
+            const uint32_t src_offset = offsets[o][1];
+            const uint32_t count = sizes[s];
+
+            memops_fill(memops_dst, 0x59u + case_index);
+            memops_copy_reference(memops_ref, memops_dst);
+            memops_move_reference(memops_ref, dest_offset, src_offset, count);
+
+            void *result = memmove(memops_dst + dest_offset,
+                                   memops_dst + src_offset, count);
+            if (result != memops_dst + dest_offset) {
+                memops_fail_kind = "memmove-ret";
+                memops_fail_case = case_index;
+                memops_fail_offset = 0;
+                memops_fail_want = (uintptr_t)(memops_dst + dest_offset);
+                memops_fail_got = (uintptr_t)result;
+                return -1;
+            }
+            if (memops_compare("memmove", case_index,
+                               memops_dst, memops_ref))
+                return -1;
+            case_index++;
+        }
+    }
+    return 0;
+}
+
+int of_memops_test_boot(void) {
+    int rc = memops_test_memcpy();
+    if (!rc)
+        rc = memops_test_memmove();
+    if (rc)
+        of_term_printf("\n  \033[91m%s case %u fault\033[0m @ +%u want %02x got %02x\n",
+                       memops_fail_kind, (unsigned)memops_fail_case,
+                       (unsigned)memops_fail_offset,
+                       (unsigned)memops_fail_want,
+                       (unsigned)memops_fail_got);
+    return rc;
+}
+
+#endif
diff --git a/src/firmware/os/hal/memtest.h b/src/firmware/os/hal/memtest.h
--- a/src/firmware/os/hal/memtest.h
+++ b/src/firmware/os/hal/memtest.h
@@ -28,0 +29,6 @@ int of_memtest_boot(void);
+#ifdef RPCMP_MEMOPS_SELFTEST
+/* Exercise the BRAM-resident memcpy/memmove implementations against cached
+ * SDRAM before filesystem or application traffic starts. */
+int of_memops_test_boot(void);
+#endif
+
diff --git a/src/firmware/os/kernel/main.c b/src/firmware/os/kernel/main.c
--- a/src/firmware/os/kernel/main.c
+++ b/src/firmware/os/kernel/main.c
@@ -657,0 +658,13 @@ void os_main(void) {
+#ifdef RPCMP_MEMOPS_SELFTEST
+    of_term_puts("  Memory ops........ ");
+    if (of_memops_test_boot() == 0) {
+        status_ok();
+    } else {
+        status_fail();
+        for (;;) {
+            of_term_puts("  \033[91mmemcpy/memmove self-test FAILED\033[0m\n");
+            of_timer_delay_ms(3000);
+        }
+    }
+#endif
+
