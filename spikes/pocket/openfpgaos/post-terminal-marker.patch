+
+#if RPCMP_EARLY_MARKER == 8
+static void rpcmp_post_terminal_marker(void) {
+    while (PAL_INDEX & PAL_INDEX_BUSY) {}
+    of_video_set_palette(15, 0xFF, 0xFF, 0xFF);
+    while (PAL_INDEX & PAL_INDEX_BUSY) {}
+
