{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-msvc",
      "displayName": "Host MSVC with Visual Studio Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/host-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "RPCMP_ENABLE_CLANG_TOOLS": "ON",
        "RPCMP_LLVM_VERSION": "22.1.8"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-msvc",
      "configurePreset": "host-msvc"
    }
  ],
  "testPresets": [
    {
      "name": "host-msvc",
      "configurePreset": "host-msvc",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "host-msvc-fast",
      "inherits": "host-msvc",
      "filter": {
        "exclude": { "name": "^tidy$" }
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "host-verify",
      "displayName": "Configure, build, and verify host on MSVC/Ninja",
      "steps": [
        { "type": "configure", "name": "host-msvc" },
        { "type": "build", "name": "host-msvc" },
        { "type": "test", "name": "host-msvc" }
      ]
    },
    {
      "name": "host-verify-fast",
      "displayName": "Configure, build, and verify host except tidy",
      "steps": [
        { "type": "configure", "name": "host-msvc" },
        { "type": "build", "name": "host-msvc" },
        { "type": "test", "name": "host-msvc-fast" }
      ]
    }
  ]
}
